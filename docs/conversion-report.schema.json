{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barrontang/gguf2mlx/conversion-report.schema.json",
  "title": "gguf2mlx conversion report",
  "description": "Written as conversion_report.json next to every conversion. Schema 2 added the three-tier fidelity block; schema 3 split the preserve gate into exact and inexact tiers and recorded the artifact size ratio; schema 4 records source tensors that intentionally or unexpectedly produced no output. Older reports remain valid: fields added since their schema version are optional here.",
  "type": "object",
  "required": ["schema_version", "architecture"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4]},
    "architecture": {"type": "string"},
    "architecture_kind": {"enum": ["dense", "moe", "hybrid"]},
    "mixed_precision": {"type": "boolean"},
    "router_protection": {"type": "boolean"},
    "protected_router_tensors": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "compressed_expert_tensors": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "unknown_tensors": {"type": "array", "items": {"type": "string"}},
    "tensor_decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "source_tensors_without_output": {
      "type": "array",
      "description": "Source GGUF tensors that were intentionally or unexpectedly not written to the MLX artifact, with a reason.",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "properties": {
          "name": {"type": "string"},
          "reason": {
            "enum": ["reproduced_from_config", "mtp_head_not_consumed", "unmapped"]
          }
        }
      }
    },

    "dtype": {"type": "string"},
    "source": {"type": ["string", "null"]},
    "conversion": {
      "type": "object",
      "properties": {
        "output_tensors": {"type": "integer"},
        "compared_tensors": {"type": "integer"},
        "skipped": {"type": "object", "additionalProperties": {"type": "integer"}}
      }
    },
    "fidelity": {
      "type": "object",
      "required": ["weight", "numerical", "perplexity"],
      "properties": {
        "weight": {"$ref": "#/$defs/weightGate"},
        "numerical": {"$ref": "#/$defs/tier"},
        "perplexity": {"$ref": "#/$defs/tier"}
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "weight": {"enum": ["pass", "fail", "not_run"]},
        "preserve": {"enum": ["pass", "fail", "not_run"]}
      }
    },
    "quant_source": {
      "enum": ["requant", "preserve"],
      "description": "Requant (the default) decodes the GGUF and quantizes from scratch; preserve re-expresses the source block codes on MLX's affine grid. Absent on artifacts written before the flag existed, which were all requantized."
    },
    "preserve": {
      "type": "object",
      "description": "Present only for --quant-source preserve: one record per tensor mapped onto the affine grid. Tensors in the `exact` tier reused their GGUF codes; `inexact` ones were re-fitted because their block layout cannot be expressed on a 32-wide grid.",
      "required": [
        "gate", "tolerance", "tensors_compared", "aggregate_relative_l2",
        "preserved_by_qtype", "preserved_by_bits", "group_size", "tensors"
      ],
      "properties": {
        "gate": {"enum": ["pass", "fail", "not_run"]},
        "tolerance": {
          "type": "number",
          "description": "Ceiling for the `exact` tier, where only fp16 scale/bias rounding is permitted. Inexact tensors are judged against preserve.tiers.inexact.tolerance instead; this field alone does not bound every tensor in the report."
        },
        "fallback": {
          "enum": ["6bit", "8bit", "float16"],
          "description": "What happened to tensors whose codes could not be reused."
        },
        "tiers": {
          "type": "object",
          "description": "Per-tier verdicts. The top-level gate passes only when every measured tier passes.",
          "properties": {
            "exact": {"$ref": "#/$defs/preserveTier"},
            "inexact": {"$ref": "#/$defs/preserveTier"}
          }
        },
        "size": {
          "type": "object",
          "description": "GGUF bytes versus written safetensors bytes, the ratio this mode is judged on.",
          "properties": {
            "source_bytes": {"type": "integer"},
            "output_bytes": {"type": "integer"},
            "ratio": {"type": "number"}
          }
        },
        "tensors_compared": {"type": "integer"},
        "tensors_total": {"type": "integer"},
        "bit_exact_tensors": {"type": "integer"},
        "aggregate_relative_l2": {"type": ["number", "null"]},
        "max_relative_l2": {"type": ["number", "null"]},
        "worst_tensor": {"type": ["string", "null"]},
        "failures": {"type": "array", "items": {"type": "string"}},
        "preserved_by_qtype": {
          "type": "object",
          "description": "How many tensors kept their codes, per GGUF block type.",
          "additionalProperties": {"type": "integer"}
        },
        "preserved_by_bits": {
          "type": "object",
          "description": "Affine width histogram, e.g. {\"4\": 120, \"8\": 4}.",
          "additionalProperties": {"type": "integer"}
        },
        "group_size": {"const": 32},
        "tensors": {"type": "array", "items": {"$ref": "#/$defs/preservedTensor"}},
        "kept_float16": {
          "type": "object",
          "description": "Tensors that could not be expressed on the affine grid at all (no mapping for the block type, not a matrix, or unaligned rows). They are decoded, never requantized.",
          "properties": {
            "counts": {"type": "object", "additionalProperties": {"type": "integer"}},
            "tensors": {"type": "array", "items": {"type": "object"}}
          }
        },
        "plan": {
          "type": "object",
          "description": "Audit plan: output tensor -> source tensor, block type, affine width, tier and row layout.",
          "additionalProperties": {
            "type": "object",
            "required": ["source", "qtype", "bits", "group_size"],
            "properties": {
              "source": {"type": "string"},
              "qtype": {"enum": ["Q4_K", "Q6_K", "Q8_0"]},
              "bits": {"enum": [4, 6, 8]},
              "group_size": {"const": 32},
              "shape": {"type": "array", "items": {"type": "integer"}},
              "rows": {"enum": ["identity", "rotary"]},
              "heads": {"type": "integer"},
              "tier": {"enum": ["exact", "inexact"]}
            }
          }
        },
        "module_bits": {
          "type": "object",
          "description": "mlx-lm module path -> affine width, mirroring config.json.",
          "additionalProperties": {"enum": [4, 6, 8]}
        }
      }
    },
    "tensor_layout": {
      "type": "object",
      "description": "Audit plan: output tensor -> source GGUF tensor and how it was written. `identity` is byte-for-byte, `reshaped` keeps the values on new axes (still value-compared), `transformed` is any other change (row permutation, fusion, split) and is not value-compared.",
      "additionalProperties": {
        "type": "object",
        "required": ["source", "layout"],
        "properties": {
          "source": {"type": "string"},
          "layout": {"enum": ["identity", "reshaped", "transformed"]}
        }
      }
    },
    "artifact": {
      "type": "object",
      "description": "Present when the audited weights are not the ones in this directory (e.g. after mlx_lm quantization).",
      "properties": {
        "stage": {"type": "string"},
        "note": {"type": "string"}
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["source_name", "output_name", "category", "precision", "protected"],
      "properties": {
        "source_name": {"type": "string"},
        "output_name": {"type": "string"},
        "category": {
          "enum": ["router", "expert_mlp", "attention", "unknown", "other"]
        },
        "precision": {"oneOf": [{"type": "integer"}, {"type": "string"}]},
        "protected": {"type": "boolean"}
      }
    },
    "tier": {
      "type": "object",
      "required": ["status", "gated"],
      "properties": {
        "status": {"type": "string"},
        "gated": {"type": "boolean"},
        "note": {"type": "string"},
        "stage": {"type": "string"},
        "error": {"type": "string"},
        "logits_shape": {"type": "array", "items": {"type": "integer"}},
        "logits_finite": {"type": "boolean"}
      }
    },
    "weightGate": {
      "type": "object",
      "required": ["status", "gated", "tolerance", "dtype"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_run"]},
        "gated": {"type": "boolean"},
        "dtype": {"type": "string"},
        "tolerance": {"type": "number"},
        "tensors_compared": {"type": "integer"},
        "tensors_total": {"type": "integer"},
        "bit_exact_tensors": {"type": "integer"},
        "max_relative_l2": {"type": ["number", "null"]},
        "worst_tensor": {"type": ["string", "null"]},
        "failures": {"type": "array", "items": {"type": "string"}},
        "failure_count": {"type": "integer"},
        "measured_stage": {"type": "string"}
      }
    },
    "preserveTier": {
      "type": "object",
      "required": ["status", "tolerance", "tensors_compared"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_run"]},
        "gated": {"type": "boolean"},
        "tolerance": {"type": "number"},
        "tensors_compared": {"type": "integer"},
        "tensors_total": {"type": "integer"},
        "bit_exact_tensors": {"type": "integer"},
        "aggregate_relative_l2": {"type": ["number", "null"]},
        "max_relative_l2": {"type": ["number", "null"]},
        "worst_tensor": {"type": ["string", "null"]},
        "failures": {"type": "array", "items": {"type": "string"}},
        "failure_count": {"type": "integer"}
      }
    },
    "preservedTensor": {
      "type": "object",
      "required": [
        "name", "source", "qtype", "bits", "group_size", "relative_l2",
        "max_abs_error", "bit_exact"
      ],
      "properties": {
        "name": {"type": "string"},
        "source": {"type": "string"},
        "qtype": {"enum": ["Q4_K", "Q6_K", "Q8_0"]},
        "bits": {"enum": [4, 6, 8]},
        "group_size": {"const": 32},
        "tier": {
          "enum": ["exact", "inexact"],
          "description": "exact: the GGUF codes were copied. inexact: the tensor was re-fitted onto the affine grid."
        },
        "elements": {"type": "integer"},
        "relative_l2": {"type": "number"},
        "max_abs_error": {"type": "number"},
        "bit_exact": {"type": "boolean"},
        "finite": {"type": "boolean"}
      }
    }
  }
}
