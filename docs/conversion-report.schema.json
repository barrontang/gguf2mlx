{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barrontang/gguf2mlx/conversion-report.schema.json",
  "title": "gguf2mlx conversion report",
  "description": "Written as conversion_report.json next to every conversion. Schema 2 adds the three-tier fidelity block; schema 1 reports (architecture_kind, tensor_decisions) remain valid because those fields are optional here.",
  "type": "object",
  "required": ["schema_version", "architecture"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "architecture": {"type": "string"},
    "architecture_kind": {"enum": ["dense", "moe", "hybrid"]},
    "mixed_precision": {"type": "boolean"},
    "router_protection": {"type": "boolean"},
    "protected_router_tensors": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "compressed_expert_tensors": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "unknown_tensors": {"type": "array", "items": {"type": "string"}},
    "tensor_decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},

    "dtype": {"type": "string"},
    "source": {"type": ["string", "null"]},
    "conversion": {
      "type": "object",
      "properties": {
        "output_tensors": {"type": "integer"},
        "compared_tensors": {"type": "integer"},
        "skipped": {"type": "object", "additionalProperties": {"type": "integer"}}
      }
    },
    "fidelity": {
      "type": "object",
      "required": ["weight", "numerical", "perplexity"],
      "properties": {
        "weight": {"$ref": "#/$defs/weightGate"},
        "numerical": {"$ref": "#/$defs/tier"},
        "perplexity": {"$ref": "#/$defs/tier"}
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "weight": {"enum": ["pass", "fail", "not_run"]},
        "preserve": {"enum": ["pass", "fail", "not_run"]}
      }
    },
    "quant_source": {
      "enum": ["requant", "preserve"],
      "description": "Requant (the default) decodes the GGUF and quantizes from scratch; preserve re-expresses the source block codes on MLX's affine grid. Absent on artifacts written before the flag existed, which were all requantized."
    },
    "preserve": {
      "type": "object",
      "description": "Present only for --quant-source preserve: one record per tensor whose GGUF block codes were reused.",
      "required": [
        "gate", "tolerance", "tensors_compared", "aggregate_relative_l2",
        "preserved_by_qtype", "preserved_by_bits", "group_size", "tensors"
      ],
      "properties": {
        "gate": {"enum": ["pass", "fail", "not_run"]},
        "tolerance": {"type": "number"},
        "tensors_compared": {"type": "integer"},
        "tensors_total": {"type": "integer"},
        "bit_exact_tensors": {"type": "integer"},
        "aggregate_relative_l2": {"type": ["number", "null"]},
        "max_relative_l2": {"type": ["number", "null"]},
        "worst_tensor": {"type": ["string", "null"]},
        "failures": {"type": "array", "items": {"type": "string"}},
        "preserved_by_qtype": {
          "type": "object",
          "description": "How many tensors kept their codes, per GGUF block type.",
          "additionalProperties": {"type": "integer"}
        },
        "preserved_by_bits": {
          "type": "object",
          "description": "Affine width histogram, e.g. {\"4\": 120, \"8\": 4}.",
          "additionalProperties": {"type": "integer"}
        },
        "group_size": {"const": 32},
        "tensors": {"type": "array", "items": {"$ref": "#/$defs/preservedTensor"}},
        "kept_float16": {
          "type": "object",
          "description": "Tensors that could not keep their codes, with the reason. They are decoded, never requantized.",
          "properties": {
            "counts": {"type": "object", "additionalProperties": {"type": "integer"}},
            "tensors": {"type": "array", "items": {"type": "object"}}
          }
        },
        "plan": {
          "type": "object",
          "description": "Audit plan: output tensor -> source tensor, block type, affine width and row layout.",
          "additionalProperties": {
            "type": "object",
            "required": ["source", "qtype", "bits", "group_size"],
            "properties": {
              "source": {"type": "string"},
              "qtype": {"enum": ["Q4_K", "Q6_K", "Q8_0"]},
              "bits": {"enum": [4, 6, 8]},
              "group_size": {"const": 32},
              "shape": {"type": "array", "items": {"type": "integer"}},
              "rows": {"enum": ["identity", "rotary"]},
              "heads": {"type": "integer"}
            }
          }
        },
        "module_bits": {
          "type": "object",
          "description": "mlx-lm module path -> affine width, mirroring config.json.",
          "additionalProperties": {"enum": [4, 6, 8]}
        }
      }
    },
    "tensor_layout": {
      "type": "object",
      "description": "Audit plan: output tensor -> source GGUF tensor and whether it was written through unchanged.",
      "additionalProperties": {
        "type": "object",
        "required": ["source", "layout"],
        "properties": {
          "source": {"type": "string"},
          "layout": {"enum": ["identity", "transformed"]}
        }
      }
    },
    "artifact": {
      "type": "object",
      "description": "Present when the audited weights are not the ones in this directory (e.g. after mlx_lm quantization).",
      "properties": {
        "stage": {"type": "string"},
        "note": {"type": "string"}
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["source_name", "output_name", "category", "precision", "protected"],
      "properties": {
        "source_name": {"type": "string"},
        "output_name": {"type": "string"},
        "category": {
          "enum": ["router", "expert_mlp", "attention", "unknown", "other"]
        },
        "precision": {"oneOf": [{"type": "integer"}, {"type": "string"}]},
        "protected": {"type": "boolean"}
      }
    },
    "tier": {
      "type": "object",
      "required": ["status", "gated"],
      "properties": {
        "status": {"type": "string"},
        "gated": {"type": "boolean"},
        "note": {"type": "string"},
        "stage": {"type": "string"},
        "error": {"type": "string"},
        "logits_shape": {"type": "array", "items": {"type": "integer"}},
        "logits_finite": {"type": "boolean"}
      }
    },
    "weightGate": {
      "type": "object",
      "required": ["status", "gated", "tolerance", "dtype"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_run"]},
        "gated": {"type": "boolean"},
        "dtype": {"type": "string"},
        "tolerance": {"type": "number"},
        "tensors_compared": {"type": "integer"},
        "tensors_total": {"type": "integer"},
        "bit_exact_tensors": {"type": "integer"},
        "max_relative_l2": {"type": ["number", "null"]},
        "worst_tensor": {"type": ["string", "null"]},
        "failures": {"type": "array", "items": {"type": "string"}},
        "failure_count": {"type": "integer"},
        "measured_stage": {"type": "string"}
      }
    },
    "preservedTensor": {
      "type": "object",
      "required": [
        "name", "source", "qtype", "bits", "group_size", "relative_l2",
        "max_abs_error", "bit_exact"
      ],
      "properties": {
        "name": {"type": "string"},
        "source": {"type": "string"},
        "qtype": {"enum": ["Q4_K", "Q6_K", "Q8_0"]},
        "bits": {"enum": [4, 6, 8]},
        "group_size": {"const": 32},
        "elements": {"type": "integer"},
        "relative_l2": {"type": "number"},
        "max_abs_error": {"type": "number"},
        "bit_exact": {"type": "boolean"},
        "finite": {"type": "boolean"}
      }
    }
  }
}
