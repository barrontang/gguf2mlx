# Tracing artifacts (regenerable: synth via make_synth_trace.py, smoke via run_trace_task_suite.sh, batch via run_trace_suite_batched.sh)
traces/synth/
traces/smoke/
traces/batch/
*.run.log
reap37_download.log
# MLA retrieval-pattern trace runs (Story 5 re-scoped). Reproducible via
# scripts/tracing/run_glm52_moe_trace.sh with TRACE_ACTIVATIONS=q_nope_absorbed,kv_cmpr.
# The full long-ctx BLUE-FALCON run emits ~1 GB of JSONL — explicitly gitignored.
traces/glm52-coding-en-retr_smoke-*.jsonl
traces/glm52-coding-en-retr_smoke-*.jsonl.meta.json
traces/glm52-coding-en-retr_full_smoke-*.jsonl
traces/glm52-coding-en-retr_full_smoke-*.jsonl.meta.json
traces/glm52-coding-en-retr_longctx-*.jsonl
traces/glm52-coding-en-retr_longctx-*.jsonl.meta.json
# Local review/roadmap notes, not part of the distributable source.
gguf2mlx-review-and-roadmap*

# CI-only pytest basetemp for the load matrix (see .github/workflows/load-matrix.yml).
load-matrix-tmp/
# Local `pytest --basetemp` when the system temp dir is not writable.
.pytest-tmp/

# Local agent workspace data (project memory + session state). Must stay on disk,
# must never be committed.
.workbuddy/

# Per-clone repo metadata written by the ghtraf tool.
.ghtraf.json

# Converted model directories from local smoke runs (260 MB+).
smollm2-135m/
